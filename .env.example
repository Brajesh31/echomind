# ==============================================================================
# EchoMind — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# --- Application Settings ---
APP_NAME=EchoMind
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- LLM Provider Credentials ---
# Required for Q&A and summary generation. Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# --- Whisper Speech-to-Text Settings ---
# Options: tiny, base, small, medium, large-v3, tiny.en, base.en
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Storage & Persistence ---
CHROMA_PATH=vector_database
DATA_PATH=downloads
SESSIONS_FILE=sessions.json

# --- Security & CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:8000,http://localhost:5500,http://127.0.0.1:5500,http://127.0.0.1:8000

# --- Limits ---
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_MINUTES=180
